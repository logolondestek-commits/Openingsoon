    <script>
        document.addEventListener("DOMContentLoaded", () => {
            gsap.registerPlugin(ScrollTrigger);

            /* =========================================
               0. LENIS SMOOTH SCROLL KURULUMU
               ========================================= */
            const lenis = new Lenis({
                duration: 1.2,
                easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                smooth: true,
                direction: 'vertical',
            });

            // GSAP ScrollTrigger'ı Lenis ile senkronize et
            lenis.on('scroll', ScrollTrigger.update);

            gsap.ticker.add((time) => {
                lenis.raf(time * 1000);
            });
            gsap.ticker.lagSmoothing(0);

            /* =========================================
               1. HERO SLIDER KODLARI
               ========================================= */
            const slides = document.querySelectorAll('.slide');
            const dots = document.querySelectorAll('.dot');
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            let currentSlide = 0;
            let isAnimating = false;
            let slideInterval;

            function goToSlide(index) {
                if (isAnimating || index === currentSlide) return;
                isAnimating = true;

                const outgoing = slides[currentSlide];
                const incoming = slides[index];

                gsap.set(incoming, { zIndex: 10 });
                gsap.set(outgoing, { zIndex: 5 });

                const incomingTitle = incoming.querySelector('h1');
                const incomingText = incoming.querySelector('p');

                const tl = gsap.timeline({
                    onComplete: () => {
                        gsap.set(outgoing, { opacity: 0 });
                        currentSlide = index;
                        isAnimating = false;
                        updateDots();
                    }
                });

                tl.fromTo(incoming, 
                    { opacity: 0 }, 
                    { opacity: 1, duration: 1, ease: "power2.inOut" }
                );

                tl.fromTo([incomingTitle, incomingText], 
                    { y: 50, opacity: 0 },
                    { y: 0, opacity: 1, duration: 0.8, stagger: 0.2, ease: "power3.out" },
                    "-=0.5"
                );
            }

            function nextSlide() {
                let next = (currentSlide + 1) % slides.length;
                goToSlide(next);
                resetInterval();
            }

            function prevSlide() {
                let prev = (currentSlide - 1 + slides.length) % slides.length;
                goToSlide(prev);
                resetInterval();
            }

            function updateDots() {
                dots.forEach((dot, idx) => {
                    if(idx === currentSlide) {
                        gsap.to(dot, { width: 32, backgroundColor: '#FF5E00', duration: 0.3 });
                    } else {
                        gsap.to(dot, { width: 12, backgroundColor: 'rgba(255,255,255,0.5)', duration: 0.3 });
                    }
                });
            }

            function resetInterval() {
                clearInterval(slideInterval);
                slideInterval = setInterval(nextSlide, 5000);
            }

            nextBtn.addEventListener('click', nextSlide);
            prevBtn.addEventListener('click', prevSlide);
            dots.forEach((dot, idx) => {
                dot.addEventListener('click', () => { goToSlide(idx); resetInterval(); });
            });

            gsap.fromTo([slides[0].querySelector('h1'), slides[0].querySelector('p')], 
                { y: 50, opacity: 0 }, 
                { y: 0, opacity: 1, duration: 1, stagger: 0.2, ease: "power3.out", delay: 0.5 }
            );
            slideInterval = setInterval(nextSlide, 5000);

            /* =========================================
               2. SCROLLYTELLING KODLARI
               ========================================= */
            const section = document.getElementById('scrolly-section');
            const stepTexts = gsap.utils.toArray('.step-text');
            const stepImgs = gsap.utils.toArray('.step-img');

            ScrollTrigger.create({
                trigger: section,
                start: "top top",
                end: "bottom bottom",
                pin: ".sticky", 
                scrub: true
            });

            const tl1 = gsap.timeline({
                scrollTrigger: {
                    trigger: section,
                    start: "10% top",
                    end: "40% top",
                    scrub: 1
                }
            });
            tl1.to(stepTexts[0], { opacity: 0, y: -20, duration: 1 })
               .to(stepTexts[1], { opacity: 1, y: 0, duration: 1 }, "<")
               .to(stepImgs[0], { clipPath: "polygon(0 0, 100% 0, 100% 0%, 0 0%)", duration: 1 }, "<");


            const tl2 = gsap.timeline({
                scrollTrigger: {
                    trigger: section,
                    start: "50% top",
                    end: "80% top",
                    scrub: 1
                }
            });
            tl2.to(stepTexts[1], { opacity: 0, y: -20, duration: 1 })
               .to(stepTexts[2], { opacity: 1, y: 0, duration: 1 }, "<")
               .to(stepImgs[1], { clipPath: "polygon(0 0, 100% 0, 100% 0%, 0 0%)", duration: 1 }, "<");

            /* =========================================
               3. NAVBAR SCROLL EFEKTİ
               ========================================= */
            window.addEventListener('scroll', () => {
                const nav = document.getElementById('navbar');
                if (window.scrollY > 50) {
                    nav.classList.add('bg-white/90', 'backdrop-blur-md', 'shadow-sm', 'py-3');
                    nav.classList.remove('py-5');
                    nav.querySelectorAll('.mix-blend-difference').forEach(el => {
                        el.classList.remove('mix-blend-difference', 'text-white');
                        el.classList.add('text-brand-black');
                    });
                } else {
                    nav.classList.remove('bg-white/90', 'backdrop-blur-md', 'shadow-sm', 'py-3');
                    nav.classList.add('py-5');
                    nav.querySelectorAll('.text-brand-black').forEach(el => {
                        el.classList.add('mix-blend-difference', 'text-white');
                        el.classList.remove('text-brand-black');
                    });
                }
            });
        });
    </script>
